  "item": [
    {
      "name": "01. Autenticación JWT",
      "item": [
        {
          "name": "01 - Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estado HTTP es 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Token JWT recibido\", function () { pm.expect(data).to.have.property('token'); });",
                  "if (data.token) { pm.environment.set(\"token_admin\", data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@mitienda.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "02 - Login Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estado HTTP es 200 OK\", function () { pm.response.to.have.status(200); });",
