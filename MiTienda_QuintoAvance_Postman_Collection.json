    {
      "name": "02. Gestión Comercial y Ventas (Req 1, 2, 3)",
      "item": [
        {
          "name": "01 - Registrar Venta Comercial (Productos y Servicios)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Venta creada exitosamente (201)\", function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Estructura de venta y factura generada\", function () {",
                  "    pm.expect(data.ok).to.eql(true);",
                  "    pm.expect(data.venta).to.have.property('numero_venta');",
                  "    pm.expect(data.venta).to.have.property('numero_factura');",
                  "});",
                  "if (data.venta && data.venta.id) { pm.environment.set(\"ultima_venta_id\", data.venta.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_nombre\": \"Carlos Gomez\",\n  \"cliente_documento\": \"1020304050\",\n  \"cliente_email\": \"carlos.gomez@example.com\",\n  \"cliente_telefono\": \"3009876543\",\n  \"direccion_entrega\": \"Carrera 15 # 85-30, Bogotá\",\n  \"ciudad\": \"Bogotá\",\n  \"metodo_pago\": \"transferencia\",\n  \"descuento\": 5000.0,\n  \"notas\": \"Prueba de venta comercial Quinto Avance\",\n  \"items\": [\n    {\n      \"tipo_item\": \"producto\",\n      \"producto_id\": 1,\n      \"nombre_item\": \"Teclado Mecánico RGB\",\n      \"precio_unitario\": 180000.0,\n      \"cantidad\": 1,\n      \"descuento\": 0.0\n    },\n    {\n      \"tipo_item\": \"servicio\",\n      \"servicio_id\": 1,\n      \"nombre_item\": \"Mantenimiento Preventivo PC\",\n      \"precio_unitario\": 65000.0,\n      \"cantidad\": 1,\n      \"descuento\": 0.0\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/ventas", "host": ["{{baseUrl}}"], "path": ["api", "ventas"] }
          }
        },
        {
          "name": "02 - Consultar Historial de Ventas General",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estado HTTP es 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Lista de ventas presente\", function () { pm.expect(data.ventas).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": { "raw": "{{baseUrl}}/api/ventas", "host": ["{{baseUrl}}"], "path": ["api", "ventas"] }
          }
        },
        {
          "name": "03 - Consultar Ventas con Filtros (Estado y Valor)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estado HTTP es 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Filtro aplicado correctamente\", function () { pm.expect(data.ok).to.eql(true); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/ventas?estado=completada&valor_min=50000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "ventas"],
              "query": [
                { "key": "estado", "value": "completada" },
                { "key": "valor_min", "value": "50000" }
              ]
            }
          }
        }
      ]
