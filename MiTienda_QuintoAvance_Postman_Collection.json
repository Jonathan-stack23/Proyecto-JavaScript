    {
      "name": "06. Módulo de PQR (Req 16)",
      "item": [
        {
          "name": "01 - Radicar Solicitud PQR",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"PQR radicada con código 201\", function () { pm.response.to.have.status(201); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Consecutivo oficial asignado (PQR-YYYY-XXXX)\", function () {",
                  "    pm.expect(data.pqr.numero_radicado).to.match(/^PQR-\\d{4}-\\d{4}$/);",
                  "});",
                  "if (data.pqr) {",
                  "    pm.environment.set(\"pqr_id\", data.pqr.id);",
                  "    pm.environment.set(\"pqr_radicado\", data.pqr.numero_radicado);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente_nombre\": \"Laura Martinez\",\n  \"cliente_email\": \"laura.martinez@example.com\",\n  \"cliente_telefono\": \"3115554433\",\n  \"tipo\": \"reclamo\",\n  \"asunto\": \"Demora en entrega de accesorios\",\n  \"descripcion\": \"Mi pedido realizado hace dos días aún no registra guía de rastreo. Solicito actualización.\",\n  \"prioridad\": \"media\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/pqr", "host": ["{{baseUrl}}"], "path": ["api", "pqr"] }
          }
        },
        {
          "name": "02 - Listar PQR (Administrador y Empleado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estado HTTP es 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Listado y resumen presentes\", function () { pm.expect(data.pqrs).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
            "url": { "raw": "{{baseUrl}}/api/pqr", "host": ["{{baseUrl}}"], "path": ["api", "pqr"] }
          }
        },
        {
          "name": "03 - Consultar PQR por Radicado Público",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estado HTTP es 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"PQR recuperada por código\", function () { pm.expect(data.pqr.numero_radicado).to.eql(pm.environment.get(\"pqr_radicado\")); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/pqr/radicado/{{pqr_radicado}}", "host": ["{{baseUrl}}"], "path": ["api", "pqr", "radicado", "{{pqr_radicado}}"] }
          }
        },
        {
          "name": "04 - Responder PQR y Actualizar Estado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Estado HTTP es 200 OK\", function () { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test(\"Estado actualizado a respondida\", function () { pm.expect(data.pqr.estado).to.eql('respondida'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respuesta\": \"Estimada Laura, hemos verificado y tu pedido ya fue entregado a la transportadora con número de guía 987654321. Recibirás tu paquete hoy.\",\n  \"estado\": \"respondida\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/pqr/{{pqr_id}}/responder", "host": ["{{baseUrl}}"], "path": ["api", "pqr", "{{pqr_id}}", "responder"] }
          }
        }
      ]
    },
